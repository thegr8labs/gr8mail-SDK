{
  "name": "gr8mail",
  "version": "0.1.0",
  "description": "Official Node.js / TypeScript SDK for Gr8Mail: send email from your own domain by API.",
  "keywords": [
    "email",
    "transactional-email",
    "smtp",
    "gr8mail",
    "send-email",
    "api"
  ],
  "homepage": "https://mail.thegr8labs.com",
  "license": "MIT",
  "author": "thegr8labs",
  "type": "module",
  "main": "./dist/cjs/index.cjs",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.cts",
        "default": "./dist/cjs/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json && tsc -p tsconfig.cjs.json && node scripts/fix-cjs.mjs",
    "test": "npm run build && node --test test/*.test.mjs",
    "prepublishOnly": "npm test"
  },
  "devDependencies": {
    "typescript": "^5.6.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thegr8labs/gr8mail-SDK.git",
    "directory": "node"
  },
  "bugs": {
    "url": "https://github.com/thegr8labs/gr8mail-SDK/issues"
  }
}
